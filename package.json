{
  "name": "erzsi-2.0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode staging --open",
    "dev:staging": "vite --mode staging --open",
    "dev:prod": "vite --mode production --open",
    "build": "vite build --mode production",
    "build:prod": "vite build --mode production",
    "build:staging": "vite build --mode staging",
    "deploy:prod": "npm run build:prod && firebase deploy --project prod",
    "deploy:staging": "npm run build:staging && firebase deploy --project staging",
    "deploy:staging:hosting": "npm run build:staging && firebase deploy --only hosting --project staging",
    "deploy:staging:backend": "firebase deploy --only firestore:rules,firestore:indexes,functions --project staging",
    "seed:staging": "node scripts/seedStagingData.mjs staging",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.1.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.9.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.1.2",
    "vite-plugin-pwa": "^1.0.2"
  }
}
