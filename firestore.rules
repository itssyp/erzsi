rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return isSignedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : null;
    }

    function accountPath() {
      return /databases/$(database)/documents/accounts/$(request.auth.uid);
    }

    function hasAccount() {
      return isSignedIn() && exists(accountPath());
    }

    function accountData() {
      return hasAccount()
        ? get(accountPath()).data
        : null;
    }

    function accountRole() {
      return hasAccount()
        && accountData().role is string
        ? accountData().role
        : null;
    }

    function accountStatus() {
      return hasAccount()
        && accountData().status is string
        ? accountData().status
        : 'active';
    }

    function effectiveRole() {
      return role() != null
        ? role()
        : accountRole();
    }

    function isAdmin() {
      return effectiveRole() == 'admin' && accountStatus() != 'disabled';
    }

    function isStaffLike() {
      return (effectiveRole() == 'staff' || effectiveRole() == 'admin')
        && accountStatus() != 'disabled';
    }

    function isOwnAccount(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function accountEventLink(eventId) {
      return get(/databases/$(database)/documents/accounts/$(request.auth.uid)/eventLinks/$(eventId));
    }

    function isLinkedUserForEvent(eventId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid)/eventLinks/$(eventId));
    }

    function isLinkedUserForPerson(eventId, personId) {
      return isLinkedUserForEvent(eventId)
        && accountEventLink(eventId).data.personId == personId;
    }

    function validUserAccountCreate(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && request.resource.data.email == request.auth.token.email;
    }

    function validOwnAccountUpdate(uid) {
      return isOwnAccount(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status;
    }

    match /accounts/{uid} {
      allow read: if isOwnAccount(uid) || isStaffLike();
      allow create: if isOwnAccount(uid) && validUserAccountCreate(uid);
      allow update: if isAdmin() || validOwnAccountUpdate(uid);
      allow delete: if isAdmin();

      match /eventLinks/{eventId} {
        allow read: if isOwnAccount(uid) || isAdmin();
        allow write: if isAdmin();
      }
    }

    match /system/runtime {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /carryoverBalances/{normalizedShibboleth} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /products/{productId} {
        allow read: if isSignedIn();
        allow write: if isStaffLike();
      }

      match /modifierTemplates/{templateId} {
        allow read: if isSignedIn();
        allow write: if isStaffLike();
      }

      match /people/{personId} {
        allow read: if isStaffLike() || isLinkedUserForPerson(eventId, personId);
        allow write: if isStaffLike();
      }

      match /baskets/{personId} {
        allow read, write: if isStaffLike();
      }

      match /orders/{orderId} {
        allow read: if isStaffLike()
          || (isLinkedUserForEvent(eventId)
            && resource.data.personId == accountEventLink(eventId).data.personId);
        allow write: if isStaffLike();
      }

      match /ledgerEntries/{entryId} {
        allow read: if isStaffLike();
        allow write: if isStaffLike();
      }

      match /auditLogs/{entryId} {
        allow read: if isAdmin();
        allow write: if isStaffLike();
      }

      match /qrAssignments/{qrId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }

      match /drsReturns/{returnId} {
        allow read, write: if isStaffLike();
      }
    }
  }
}
