rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return isSignedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : null;
    }

    function accountPath() {
      return /databases/$(database)/documents/accounts/$(request.auth.uid);
    }

    function hasAccount() {
      return isSignedIn() && exists(accountPath());
    }

    function accountData() {
      return hasAccount()
        ? get(accountPath()).data
        : null;
    }

    function accountRole() {
      return hasAccount()
        && accountData().role is string
        ? accountData().role
        : null;
    }

    function accountStatus() {
      return hasAccount()
        && accountData().status is string
        ? accountData().status
        : 'active';
    }

    function effectiveRole() {
      return role() != null
        ? role()
        : accountRole();
    }

    function isAdmin() {
      return effectiveRole() == 'admin' && accountStatus() != 'disabled';
    }

    function isStaffLike() {
      return (effectiveRole() == 'staff' || effectiveRole() == 'pos_staff' || effectiveRole() == 'head_pos' || effectiveRole() == 'admin')
        && accountStatus() != 'disabled';
    }

    function canUsePos() {
      return (effectiveRole() == 'admin' || effectiveRole() == 'staff' || effectiveRole() == 'pos_staff' || effectiveRole() == 'head_pos')
        && accountStatus() != 'disabled';
    }

    function canUseKitchen() {
      return (effectiveRole() == 'admin' || effectiveRole() == 'staff' || effectiveRole() == 'pos_staff')
        && accountStatus() != 'disabled';
    }

    function canUseTopup() {
      return (effectiveRole() == 'admin' || effectiveRole() == 'topup_staff')
        && accountStatus() != 'disabled';
    }

    function canManageCatalog() {
      return (effectiveRole() == 'admin' || effectiveRole() == 'staff' || effectiveRole() == 'head_pos')
        && accountStatus() != 'disabled';
    }

    function canManagePeople() {
      return (effectiveRole() == 'admin' || effectiveRole() == 'staff')
        && accountStatus() != 'disabled';
    }

    function validPosPersonBalanceUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'updatedAt'])
        && request.resource.data.balance is number;
    }

    function validKitchenEventUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isKitchenClosed', 'updatedBy', 'updatedAt'])
        && request.resource.data.isKitchenClosed is bool
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validPosProductAvailabilityUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isTemporarilyUnavailable', 'updatedBy', 'updatedAt'])
        && request.resource.data.isTemporarilyUnavailable is bool
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validPosStockItemUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentQuantity', 'updatedBy', 'updatedAt'])
        && request.resource.data.currentQuantity is number
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validPosStockMovementCreate() {
      return request.resource.data.type in ['sale', 'refund']
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.stockItemId is string
        && request.resource.data.quantityDelta is number
        && request.resource.data.createdAt == request.time;
    }

    function isOwnAccount(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function accountEventLink(eventId) {
      return get(/databases/$(database)/documents/accounts/$(request.auth.uid)/eventLinks/$(eventId));
    }

    function isLinkedUserForEvent(eventId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid)/eventLinks/$(eventId));
    }

    function isLinkedUserForPerson(eventId, personId) {
      return isLinkedUserForEvent(eventId)
        && accountEventLink(eventId).data.personId == personId;
    }

    function validUserAccountCreate(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && request.resource.data.email == request.auth.token.email;
    }

    function validOwnAccountUpdate(uid) {
      return isOwnAccount(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status;
    }

    match /accounts/{uid} {
      allow read: if isOwnAccount(uid) || isStaffLike() || canUseTopup();
      allow create: if isOwnAccount(uid) && validUserAccountCreate(uid);
      allow update: if isAdmin() || validOwnAccountUpdate(uid);
      allow delete: if isAdmin();

      match /eventLinks/{eventId} {
        allow read: if isOwnAccount(uid) || isAdmin();
        allow write: if isAdmin();
      }

      match /pushTokens/{deviceId} {
        allow read, delete: if isOwnAccount(uid);
        allow create, update: if isOwnAccount(uid)
          && accountRole() == 'user'
          && accountStatus() == 'active'
          && request.resource.data.keys().hasOnly(['token', 'origin', 'updatedAt'])
          && request.resource.data.keys().hasAll(['token', 'origin', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 4096
          && request.resource.data.origin is string
          && request.resource.data.origin.size() <= 150
          && request.resource.data.updatedAt == request.time;
      }
    }

    match /system/runtime {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /carryoverBalances/{normalizedShibboleth} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (canUseKitchen() && validKitchenEventUpdate());

      match /products/{productId} {
        allow read: if isSignedIn();
        allow create, delete: if canManageCatalog();
        allow update: if canManageCatalog() || (canUsePos() && validPosProductAvailabilityUpdate());
      }

      match /productBarcodes/{barcode} {
        allow read: if isSignedIn();
        allow write: if canManageCatalog();
      }

      match /modifierTemplates/{templateId} {
        allow read: if isSignedIn();
        allow write: if canManageCatalog();
      }

      match /stockItems/{stockItemId} {
        allow read: if isSignedIn();
        allow create, delete: if canManageCatalog();
        allow update: if canManageCatalog() || (canUsePos() && validPosStockItemUpdate());
      }

      match /stockMovements/{movementId} {
        allow read: if canManageCatalog() || canUsePos();
        allow create: if canManageCatalog() || (canUsePos() && validPosStockMovementCreate());
        allow update, delete: if false;
      }

      match /people/{personId} {
        allow read: if canUsePos() || canUseTopup() || isLinkedUserForPerson(eventId, personId);
        allow create, delete: if canManagePeople();
        allow update: if canManagePeople() || (canUsePos() && validPosPersonBalanceUpdate());
      }

      match /baskets/{personId} {
        allow read, write: if canUsePos();
      }

      match /orders/{orderId} {
        allow read: if canUsePos()
          || (isLinkedUserForEvent(eventId)
            && (
              resource.data.personId == accountEventLink(eventId).data.personId
              || resource.data.hasFood == true
            ));
        allow write: if canUsePos();
      }

      match /ledgerEntries/{entryId} {
        allow read: if canUsePos() || canUseTopup();
        allow write: if canUsePos();
      }

      match /auditLogs/{entryId} {
        allow read: if isAdmin();
        allow write: if canUsePos();
      }

      match /qrAssignments/{qrId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }

      match /drsReturns/{returnId} {
        allow read, write: if canUsePos();
      }
    }
  }
}
